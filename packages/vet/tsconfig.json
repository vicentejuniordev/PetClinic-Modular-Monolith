{
    "$schema": "https://www.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "declaration": true,
        "esModuleInterop": true,
        "strict": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,



    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules","dist"
    ]
}
